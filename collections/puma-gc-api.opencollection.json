{
  "opencollection": "1.0.0",
  "info": {
    "name": "Puma Control/Status Application Gc API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Gc",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Run garbage collection",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://127.0.0.1:9293/gc"
          },
          "docs": "Triggers a Ruby `GC.start` in the Puma process."
        }
      ]
    }
  ],
  "bundled": true
}