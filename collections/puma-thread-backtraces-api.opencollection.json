{
  "opencollection": "1.0.0",
  "info": {
    "name": "Puma Control/Status Application Gc Thread Backtraces API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Thread Backtraces",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Thread backtraces",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://127.0.0.1:9293/thread-backtraces"
          },
          "docs": "Returns the current thread backtraces for the Puma process as a JSON array."
        }
      ]
    }
  ],
  "bundled": true
}